<Window x:Class="AplicatieMagazin.FereastraMagazine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrare Magazine (C.R.U.D)" Height="450" Width="600" Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Lista Magazine" Grid.Column="0" Background="White" Padding="10">
            <StackPanel>
                <ListBox x:Name="lstMagazine" Height="250" Margin="0,0,0,10" SelectionChanged="OnMagazinSelectat"/>

                <Label Content="{Binding ElementName=lstMagazine, Path=Items.Count, StringFormat='Total magazine înregistrate: {0}'}" 
                       FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Detalii Magazin" Grid.Column="2" Background="White" Padding="15">
            <StackPanel x:Name="panouDetalii">
                <Label Content="ID Magazin:" FontWeight="Bold"/>
                <TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10" IsEnabled="False"/>

                <Label Content="Brand (Nume):" FontWeight="Bold"/>
                <TextBox Text="{Binding Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

                <Label Content="Filiala (Locație):" FontWeight="Bold"/>
                <TextBox Text="{Binding Filiala, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,20"/>

                <Button Content="ADAUGĂ NOU (Create)" Background="#27AE60" Foreground="White" FontWeight="Bold" Height="35" Margin="0,0,0,10" Click="OnAdaugaClick"/>
                <Button Content="ACTUALIZEAZĂ (Update)" Background="#F39C12" Foreground="White" FontWeight="Bold" Height="35" Margin="0,0,0,10" Click="OnUpdateClick"/>
                <Button Content="ŞTERGE (Delete)" Background="#E74C3C" Foreground="White" FontWeight="Bold" Height="35" Click="OnDeleteClick"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>