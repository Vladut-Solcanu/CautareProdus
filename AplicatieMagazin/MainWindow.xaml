<Window x:Class="AplicatieMagazin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afișare Entitate Produs" Height="350" Width="400">

    <Window.Resources>
        <SolidColorBrush x:Key="CuloarePrincipala" Color="#2C3E50"/>
        <SolidColorBrush x:Key="CuloareAccent" Color="#1B4F72"/>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource CuloarePrincipala}"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
        </Style>
    </Window.Resources>

    <Grid Background="LightGray">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Label Content="Informații Produs:" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CuloareAccent}"/>

            <Label Name="lblId" />
            <Label Name="lblNume" />
            <Label Name="lblCategorie" />
            <Label Name="lblPret" />

        </StackPanel>
    </Grid>
</Window>