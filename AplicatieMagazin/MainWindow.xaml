<Window x:Class="AplicatieMagazin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Gestiune Magazin - Căutare" Height="550" Width="750"
        Background="Green" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" Padding="5">
            <MenuItem Header="_Căutare">
                <MenuItem Header="_Resetează Căutarea" Click="OnResetClick"/>
                <Separator />
                <MenuItem Header="_Ieșire din aplicație" Click="OnExitClick"/>
            </MenuItem>

            <MenuItem Header="_Administrare">
                <MenuItem Header="Gestionează _Produse (CRUD)" Click="OnDeschideProduseClick"/>
                <MenuItem Header="Gestionează _Magazine (CRUD)" Click="OnDeschideMagazineClick"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="40">
            <Border Background="White" Padding="25" CornerRadius="8" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Căutare Rapidă Produse" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50" TextAlignment="Center"/>

                    <Label Content="Introduceți numele produsului pentru căutare:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCautaNume" Grid.Column="0" Margin="0,0,15,0" Height="40" FontSize="16" Padding="10,0" VerticalContentAlignment="Center"/>

                        <Button x:Name="btnCauta" Content="CAUTĂ" Grid.Column="1" Click="OnCautaClick" Background="#2980B9" Foreground="White" FontWeight="Bold" Height="40">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ListBox x:Name="lstRezultateCautare" Height="220" Padding="5" BorderBrush="#BDC3C7" BorderThickness="1" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9F9" BorderBrush="#E5E8E8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nume}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding Categorie, StringFormat='Categorie: {0}'}" FontSize="13" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Etichete, StringFormat='Atribute: {0}'}" FontSize="12" Foreground="#27AE60" Margin="0,5,0,0" FontStyle="Italic"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Pret, StringFormat='{}{0:F2} Lei'}" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NumeMagazin}" FontSize="14" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Culoar, StringFormat='Culoar: {0}'}" FontSize="12" Foreground="#34495E" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Raft, StringFormat='Raft: {0}'}" FontSize="12" Foreground="#34495E" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="txtStatusCautare" Foreground="Red" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="Collapsed" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>