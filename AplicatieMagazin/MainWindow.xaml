<Window x:Class="AplicatieMagazin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Produse Magazin" Height="400" Width="600"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label x:Name="lblMagazin" Content="_Magazin:" Grid.Row="0" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,5,10,5" 
               Target="{Binding ElementName=cmbMagazin}" FontWeight="SemiBold"/>
        <ComboBox x:Name="cmbMagazin" Grid.Row="0" Grid.Column="1" 
                  Margin="0,5" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="errMagazin" Text="Selectați un magazin!" Grid.Row="0" Grid.Column="2" 
                   Foreground="Red" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>

        <Label x:Name="lblNume" Content="_Nume produs:" Grid.Row="1" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,5,10,5" 
               Target="{Binding ElementName=txtNume}" FontWeight="SemiBold"/>
        <TextBox x:Name="txtNume" Grid.Row="1" Grid.Column="1" 
                 Margin="0,5" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="errNume" Text="Nume invalid (max 15 caractere)!" Grid.Row="1" Grid.Column="2" 
                   Foreground="Red" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>

        <Label x:Name="lblCategorie" Content="_Categorie:" Grid.Row="2" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,5,10,5" 
               Target="{Binding ElementName=cmbCategorie}" FontWeight="SemiBold"/>
        <ComboBox x:Name="cmbCategorie" Grid.Row="2" Grid.Column="1" 
                  Margin="0,5" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="errCategorie" Text="Selectați categoria!" Grid.Row="2" Grid.Column="2" 
                   Foreground="Red" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>

        <Label x:Name="lblCuloar" Content="C_uloar (1-20):" Grid.Row="3" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,5,10,5" 
               Target="{Binding ElementName=txtCuloar}" FontWeight="SemiBold"/>
        <TextBox x:Name="txtCuloar" Grid.Row="3" Grid.Column="1" 
                 Margin="0,5" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="errCuloar" Text="Culoar invalid!" Grid.Row="3" Grid.Column="2" 
                   Foreground="Red" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>

        <Label x:Name="lblRaft" Content="_Raft (1-50):" Grid.Row="4" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,5,10,5" 
               Target="{Binding ElementName=txtRaft}" FontWeight="SemiBold"/>
        <TextBox x:Name="txtRaft" Grid.Row="4" Grid.Column="1" 
                 Margin="0,5" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="errRaft" Text="Raft invalid!" Grid.Row="4" Grid.Column="2" 
                   Foreground="Red" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>

        <Button x:Name="btnAdauga" Content="Adaugă Produs" Grid.Row="5" Grid.Column="1" 
                Height="35" Margin="0,15,0,0" Background="#2C3E50" Foreground="White" 
                FontWeight="Bold" Click="OnAdaugaClick"/>

        <TextBlock x:Name="txtStatus" Grid.Row="6" Grid.Column="1" 
                   Margin="0,10,0,0" TextAlignment="Center" FontWeight="Bold"
                   Visibility="Collapsed"/>
    </Grid>
</Window>