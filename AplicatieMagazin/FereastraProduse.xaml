<Window x:Class="AplicatieMagazin.FereastraProduse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrare Produse (CRUD)" Height="650" Width="550" Background="#F0F2F5" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" Padding="25" CornerRadius="8" Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Adăugare Produs" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

                <Label Content="_Nume Produs:"/>
                <TextBox x:Name="txtNume" Text="{Binding ProdusCurent.Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <TextBlock Foreground="Red" FontSize="11" Margin="2,-5,0,10" Text="{Binding ElementName=txtNume, Path=(Validation.Errors)/ErrorContent}"/>

                <Label Content="_Categorie:"/>
                <ComboBox x:Name="cmbCategorie"/>

                <Label Content="_Preț (Lei):"/>
                <TextBox x:Name="txtPret" Text="{Binding ProdusCurent.Pret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <TextBlock Foreground="Red" FontSize="11" Margin="2,-5,0,10" Text="{Binding ElementName=txtPret, Path=(Validation.Errors)/ErrorContent}"/>

                <Label Content="Etichete Produs (Opțional):"/>
                <WrapPanel Margin="0,5,0,15">
                    <CheckBox x:Name="chkFaraZahar" Content="Fără Zahăr" Margin="0,0,15,5"/>
                    <CheckBox x:Name="chkFaraGluten" Content="Fără Gluten" Margin="0,0,15,5"/>
                    <CheckBox x:Name="chkLocal" Content="Produs Local" Margin="0,0,15,5"/>
                    <CheckBox x:Name="chkOferta" Content="Ofertă Specială" Margin="0,0,0,5"/>
                </WrapPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="_Culoar (1-20):"/>
                        <TextBox x:Name="txtCuloar" Text="{Binding ProdusCurent.Culoar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Foreground="Red" FontSize="10" Text="{Binding ElementName=txtCuloar, Path=(Validation.Errors)/ErrorContent}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="_Raft (1-50):"/>
                        <TextBox x:Name="txtRaft" Text="{Binding ProdusCurent.Raft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        <TextBlock Foreground="Red" FontSize="10" Text="{Binding ElementName=txtRaft, Path=(Validation.Errors)/ErrorContent}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Selectați Magazinul de Proveniență:"/>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                    <StackPanel x:Name="pnlMagazine" Orientation="Horizontal"/>
                </Border>

                <Button x:Name="btnAdauga" Content="SALVEAZĂ NOU" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="OnAdaugaClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="txtStatus" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>